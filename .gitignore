
# ==========================================================
# E-LEARN PLATFORM - GLOBAL GITIGNORE
# Frontend: React + Vite + Node.js
# Backend: Java + Spring Boot + Maven
# OS: Windows, Linux, macOS
# IDEs: IntelliJ IDEA, VS Code, Eclipse
# ==========================================================


# ==========================================================
# 1. ENVIRONMENT VARIABLES AND SECRETS
# ==========================================================

.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

secrets/
credentials/
private/


# ==========================================================
# 2. FRONTEND - NODE.JS / REACT / VITE
# ==========================================================

# Dependencies
client/node_modules/
node_modules/

# Build outputs
client/dist/
client/build/
client/out/

# Vite
client/.vite/
client/vite.config.*.timestamp-*

# Testing and coverage
client/coverage/
client/.nyc_output/
client/test-results/
client/playwright-report/

# Logs
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*
client/*.log
client/logs/

# Package manager caches
client/.npm/
client/.yarn/cache/
client/.pnpm-store/

# Optional frontend caches
client/.eslintcache
client/.stylelintcache
client/.parcel-cache/

# TypeScript generated files
client/*.tsbuildinfo


# ==========================================================
# 3. BACKEND - JAVA / SPRING BOOT / MAVEN
# ==========================================================

# Maven build output
server/target/
server/.mvn/wrapper/maven-wrapper.jar

# Compiled Java files
*.class
*.jar
*.war
*.ear

# JVM crash dumps
hs_err_pid*
replay_pid*

# Spring Boot logs
server/logs/
server/*.log

# Generated reports
server/site/
server/coverage/

# Temporary files
server/tmp/
server/temp/


